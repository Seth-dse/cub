import math

// Classes, inheritance, and methods that a subclass replaces.
class Shape {
    name: string

    void init(name: string) {
        self.name = name
    }

    float area() {
        return 0.0
    }

    float perimeter() {
        return 0.0
    }

    // print() uses this whenever a class declares it.
    string to_string() {
        return "{pad_end(self.name, 10, " ")} area {pad_start(str(round2(self.area())), 8, " ")}" +
            "  perimeter {pad_start(str(round2(self.perimeter())), 8, " ")}"
    }
}

class Rectangle: Shape {
    width: float
    height: float

    void init(width: float, height: float) {
        super.init("rectangle")
        self.width = width
        self.height = height
    }

    float area() {
        return self.width * self.height
    }

    float perimeter() {
        return 2.0 * (self.width + self.height)
    }
}

class Square: Rectangle {
    void init(side: float) {
        super.init(side, side)
        self.name = "square"
    }
}

class Circle: Shape {
    radius: float

    void init(radius: float) {
        super.init("circle")
        self.radius = radius
    }

    float area() {
        return math.PI * self.radius * self.radius
    }

    float perimeter() {
        return math.TAU * self.radius
    }
}

float round2(v: float) {
    return math.round(v * 100.0) / 100.0
}

void main() {
    // Every one of these is a Shape, and each keeps its own behaviour.
    let shapes: [Shape] = [
        Rectangle(3.0, 4.0),
        Square(5.0),
        Circle(1.0),
    ]

    for s in shapes {
        print(s)
    }

    var total = 0.0
    for s in shapes {
        total += s.area()
    }
    print("")
    print("total area: {round2(total)}")

    // The largest one, found without knowing which class it is.
    var biggest = shapes[0]
    for s in shapes {
        if s.area() > biggest.area() {
            biggest = s
        }
    }
    print("largest:    {biggest.name} at {round2(biggest.area())}")
}
