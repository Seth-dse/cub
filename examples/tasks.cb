// A small to-do list, showing structs, enums, and arrays together.
enum Status { Todo, Doing, Done }

struct Task {
    title: string;
    status: Status;
    hours: float;
}

fn mark(list: [Task], title: string, status: Status) {
    for i in 0..len(list) {
        if list[i].title == title {
            list[i].status = status;
            return;
        }
    }
    print("no task called \"{title}\"");
}

fn symbol(s: Status): string {
    if s == Status.Done {
        return "[x]";
    } else if s == Status.Doing {
        return "[~]";
    }
    return "[ ]";
}

fn show(list: [Task]) {
    var remaining = 0.0;
    for t in list {
        print("{symbol(t.status)} {t.title} ({t.hours}h)");
        if t.status != Status.Done {
            remaining += t.hours;
        }
    }
    print("{remaining} hours left");
}

fn main() {
    let list = [
        Task { title: "write the parser", status: Status.Done, hours: 6.0 },
        Task { title: "write the checker", status: Status.Doing, hours: 4.5 },
        Task { title: "write the docs", status: Status.Todo, hours: 2.0 },
    ];

    show(list);
    print("");

    mark(list, "write the checker", Status.Done);
    mark(list, "take a nap", Status.Done);
    push(list, Task { title: "ship it", status: Status.Todo, hours: 0.5 });
    print("");
    show(list);
}
