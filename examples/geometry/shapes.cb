import math

/// A shape that knows how much space it covers.
class Shape {
    /// What to call this shape when showing it.
    name: string

    void init(name: string) {
        self.name = name
    }

    /// How much space the shape covers.
    float area() {
        return 0.0
    }
}

/// A circle, described by how far its edge sits from the middle.
class Circle: Shape {
    /// The distance from the middle to the edge.
    radius: float

    void init(radius: float) {
        super.init("circle")
        self.radius = radius
    }

    float area() {
        return math.PI * self.radius * self.radius
    }
}

/// A rectangle, described by two sides.
class Rect: Shape {
    /// The side running left to right.
    width: float
    /// The side running top to bottom.
    height: float

    void init(width: float, height: float) {
        super.init("rectangle")
        self.width = width
        self.height = height
    }

    float area() {
        return self.width * self.height
    }
}
