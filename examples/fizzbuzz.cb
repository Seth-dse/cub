// Classic FizzBuzz, one line per number.
fn label(n: int): string {
    if n % 15 == 0 {
        return "FizzBuzz";
    } else if n % 3 == 0 {
        return "Fizz";
    } else if n % 5 == 0 {
        return "Buzz";
    }
    return str(n);
}

fn main() {
    for n in 1..=20 {
        print(label(n));
    }
}
