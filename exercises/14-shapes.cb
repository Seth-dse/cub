// Exercise 14 — Shapes
//
// Tutorial: section 11 (building on a class).
//
// `Shape` says every shape has a name and an area.  Each kind below
// replaces `area` with its own:
//   Rect     width * height
//   Square   a Rect with both sides the same -- call super.init(side, side)
//            and then rename it to "square"
//   Circle   math.PI * radius * radius
//
// The point of the loop in main: it holds Shapes, and never asks which
// kind it has.  Each one still uses its own `area`.

import math;

class Shape {
    name: string;

    fn init(name: string) {
        self.name = name;
    }

    fn area(): float {
        return 0.0;
    }

    fn to_string(): string {
        return "{pad_end(self.name, 10, ".")} {math.round(self.area() * 100.0) / 100.0}";
    }
}

class Rect extends Shape {
    width: float;
    height: float;

    fn init(width: float, height: float) {
        super.init("rectangle");
        // TODO: keep width and height
    }

    // TODO: replace area()
}

// TODO: class Square, built on Rect

// TODO: class Circle, built on Shape

fn main() {
    let shapes: [Shape] = [Rect(3.0, 4.0)];
    // once Square and Circle exist, use:
    // let shapes: [Shape] = [Rect(3.0, 4.0), Square(5.0), Circle(1.0)]

    var total = 0.0;
    for s in shapes {
        print(s);
        total += s.area();
    }
    print("total {math.round(total * 100.0) / 100.0}");

    // TODO: find the shape with the largest area and print
    //       "largest is the {name}"
}
