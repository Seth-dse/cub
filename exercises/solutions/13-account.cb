class Account {
    owner: string;
    balance: int;

    fn init(owner: string) {
        self.owner = owner;
    }

    fn deposit(amount: int) {
        if amount <= 0 {
            print("  a deposit must be more than nothing");
            return;
        }
        self.balance += amount;
    }

    fn withdraw(amount: int): bool {
        if amount > self.balance {
            print("  {self.owner} cannot take out {amount}, only has {self.balance}");
            return false;
        }
        self.balance -= amount;
        return true;
    }

    fn to_string(): string {
        return "{self.owner}: {self.balance}";
    }
}

fn main() {
    let a = Account("Ada");
    a.deposit(100);
    a.deposit(50);
    print(a);

    print(a.withdraw(30));
    print(a.withdraw(500));
    print(a);

    a.deposit(-5);

    let shared = a;
    shared.deposit(1000);
    print(a);
}
