import math;

float mean(values: [int]) {
    if len(values) == 0 {
        return 0.0;
    }
    return float(sum(values)) / float(len(values));
}

int median(values: [int]) {
    let ordered = copy(values);
    sort(ordered);
    return ordered[len(ordered) / 2];
}

float round2(v: float) {
    return math.round(v * 100.0) / 100.0;
}

void main() {
    let values = [8, 3, 17, 4, 9, 12];

    print(sum(values));
    print(min_of(values), " ", max_of(values));
    print(round2(mean(values)));
    print(median(values));

    let ordered = copy(values);
    sort(ordered);
    print(ordered);
    reverse(ordered);
    print(ordered);
    print(values);
}
