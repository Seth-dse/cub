string grade(score: int) {
    if score >= 90 {
        return "A"
    } else if score >= 80 {
        return "B"
    } else if score >= 70 {
        return "C"
    }
    return "F"
}

void main() {
    for score in [95, 83, 71, 40] {
        print("{score}: {grade(score)}")
    }

    let n = 7
    print("{n} is {if n % 2 == 0 { "even" } else { "odd" }}")
}
