import math;

class Shape {
    name: string;

    fn init(name: string) {
        self.name = name;
    }

    fn area(): float {
        return 0.0;
    }

    fn to_string(): string {
        return "{pad_end(self.name, 10, ".")} {math.round(self.area() * 100.0) / 100.0}";
    }
}

class Rect extends Shape {
    width: float;
    height: float;

    fn init(width: float, height: float) {
        super.init("rectangle");
        self.width = width;
        self.height = height;
    }

    fn area(): float {
        return self.width * self.height;
    }
}

class Square extends Rect {
    fn init(side: float) {
        super.init(side, side);
        self.name = "square";
    }
}

class Circle extends Shape {
    radius: float;

    fn init(radius: float) {
        super.init("circle");
        self.radius = radius;
    }

    fn area(): float {
        return math.PI * self.radius * self.radius;
    }
}

fn main() {
    let shapes: [Shape] = [Rect(3.0, 4.0), Square(5.0), Circle(1.0)];

    var total = 0.0;
    for s in shapes {
        print(s);
        total += s.area();
    }
    print("total {math.round(total * 100.0) / 100.0}");

    var biggest = shapes[0];
    for s in shapes {
        if s.area() > biggest.area() {
            biggest = s;
        }
    }
    print("largest is the {biggest.name}");
}
