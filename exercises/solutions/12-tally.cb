fn tally(text: string): [string: int] {
    var counts: [string: int] = [:];
    for word in split(lower(text), " ") {
        let clean = trim(word);
        if len(clean) == 0 {
            continue;
        }
        counts[clean] = get(counts, clean, 0) + 1;
    }
    return counts;
}

fn main() {
    let counts = tally("the quick brown fox the lazy dog the end");

    print(len(counts));
    print(counts["the"]);
    print(has(counts, "fox"), has(counts, "cat"));
    print(get(counts, "cat", 0));

    var words = keys(counts);
    sort(words);
    for word in words {
        print("{pad_end(word, 8, ".")} {counts[word]}");
    }
}
