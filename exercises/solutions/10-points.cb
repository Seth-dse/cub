type Point = struct {
    x: int,
    y: int,
}

int distance_squared(a: Point, b: Point) {
    let dx = a.x - b.x
    let dy = a.y - b.y
    return dx * dx + dy * dy
}

Point shifted(p: Point, dx: int, dy: int) {
    return Point { x: p.x + dx, y: p.y + dy }
}

void main() {
    let origin = Point { x: 0, y: 0 }
    let target = Point { x: 3, y: 4 }

    print(origin)
    print(target)
    print(distance_squared(origin, target))
    print(shifted(target, 10, -2))

    var copy_of = target
    copy_of.x = 99
    print(target.x, " ", copy_of.x)

    let path = [origin, target, Point { x: 6, y: 8 }]
    var total = 0
    for i in 1..len(path) {
        total += distance_squared(path[i - 1], path[i])
    }
    print(total)
}
