fn is_even(n: int): bool {
    return n % 2 == 0;
}

fn describe(n: int): string {
    if n < 0 {
        return "negative";
    } else if n == 0 {
        return "zero";
    }
    return if is_even(n) { "positive and even" } else { "positive and odd" };
}

fn banner(title: string) {
    print(repeat("=", len(title)));
    print(title);
    print(repeat("=", len(title)));
}

fn main() {
    banner("Numbers");
    for n in [-4, 0, 7, 12] {
        print("{n} is {describe(n)}");
    }
}
