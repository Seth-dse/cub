void main() {
    var n = 5
    while n > 0 {
        print(n)
        n -= 1
    }
    print("liftoff")

    for i in 1..=5 {
        write("{i} ")
    }
    print("")

    for i in 1..=10 {
        if i % 2 == 1 {
            continue
        }
        if i > 8 {
            break
        }
        write("{i} ")
    }
    print("")
}
