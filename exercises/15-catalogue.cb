fn main() {
    let lines = [
        "Dune          | Herbert   | 3",
        "Emma          | Austen    | 2",
        "Persuasion    | Austen    | 1",
        "Children Of D | Herbert   | 4",
    ];

    let shelf = Catalogue();
    for line in lines {
        shelf.add(parse(line));
