// Globals are visible everywhere.
let VERSION = "1.0";
var counter = 0;

struct Box { value: int; }

int bump() {
    counter += 1;
    return counter;
}

// Arrays are shared; structs are copied.
void fill(items: [int]) {
    push(items, 99);
}

Box grow(b: Box) {
    return Box { value: b.value + 1 };
}

void main() {
    print("version {VERSION}");
    print(bump(), bump(), bump());

    var shared = [1];
    fill(shared);
    print(shared);

    let alias = shared;
    push(alias, 2);
    print(shared, " ", alias);

    let b = Box { value: 1 };
    let b2 = grow(b);
    print(b, b2);

    var copy = b;
    copy.value = 42;
    print(b, copy);

    // Shadowing: the inner name is a different variable.
    let x = 1;
    {
        let x = x + 10;
        print("inner {x}");
    }
    print("outer {x}");

    // A `let` array can still have its contents changed.
    let fixed = [1, 2, 3];
    fixed[0] = 9;
    push(fixed, 4);
    print(fixed);
}
