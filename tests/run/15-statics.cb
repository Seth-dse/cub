class MathKit {
    static fn double(n: int): int { return n * 2; }
    static fn clamp01(n: int): int { return clamp(n, 0, 1); }
    static fn shout(s: string): string { return upper(s) + "!"; }
}

class App {
    greeting: string;

    fn init() {
        self.greeting = "hello from a class";
    }

    fn main() {
        print(self.greeting);
        print(MathKit.double(21));
        print(MathKit.shout("cub"));
        print(MathKit.clamp01(9));
    }
}
