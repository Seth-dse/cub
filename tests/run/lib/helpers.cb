import math;

/// Doubles a whole number.
fn double(n: int): int { return n * 2; }

/// Rounds to two decimal places.
fn round2(v: float): float { return math.round(v * 100.0) / 100.0; }

/// A named quantity.
class Measure {
    /// What is being measured.
    label: string;
    /// How much of it there is.
    amount: float;

    fn init(label: string, amount: float) {
        self.label = label;
        self.amount = amount;
    }

    fn to_string(): string { return "{self.label}={round2(self.amount)}"; }
}
