class MathKit {
    static int double(n: int) { return n * 2 }
    static int clamp01(n: int) { return clamp(n, 0, 1) }
    static string shout(s: string) { return upper(s) + "!" }
}

class App {
    greeting: string

    void init() {
        self.greeting = "hello from a class"
    }

    void main() {
        print(self.greeting)
        print(MathKit.double(21))
        print(MathKit.shout("cub"))
        print(MathKit.clamp01(9))
    }
}
