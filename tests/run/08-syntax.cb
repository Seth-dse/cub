/* A block comment
   /* that nests */
   and keeps going. */
int total(
    a: int,
    b: int, // trailing comma below is fine
    c: int,
) {
    return a + b + c;
}

void main() {
    // Every statement ends with a semicolon.
    let a = 1;
    let b = 2;
    print(a + b);

    // Line breaks mean nothing, so an expression may be laid out freely:
    // broken after an operator...
    let long = 1 +
        2 +
        3;
    print(long);

    // ...or before one.
    let same = 1
        + 2
        + 3;
    print(same);

    // A whole statement may sit on several lines.
    let items
        =
        [
            10,
            20,
            30,
        ];
    print(items);
    print(total(
        1,
        2,
        3,
    ));

    // A stray semicolon is an empty statement, and harmless.
    ;;

    // A condition needs no parentheses, but may have them, and may run
    // across lines of its own.
    if a < b
        and (b < 10) {
        print("ordered");
    }

    let nested = total(total(1, 1, 1), 2, 3);
    print(nested);
}
