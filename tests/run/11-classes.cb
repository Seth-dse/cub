class Shape {
    name: string
    void init(name: string) { self.name = name }
    float area() { return 0.0 }
    string to_string() { return "{self.name} of area {self.area_str()}" }
    string area_str() { return str(self.area()) }
}

class Rect: Shape {
    w: float
    h: float
    void init(w: float, h: float) {
        super.init("rectangle")
        self.w = w
        self.h = h
    }
    float area() { return self.w * self.h }
}

class Square: Rect {
    void init(side: float) {
        super.init(side, side)
        self.name = "square"
    }
    string describe() {
        return "a {self.name} with side {self.w}, twice the base area is {super.area() * 2.0}"
    }
}

class Counter {
    count: int
    void bump() { self.count += 1 }
    int value() { return self.count }
}

void main() {
    let shapes: [Shape] = [Rect(3.0, 4.0), Square(5.0)]
    for s in shapes {
        print(s)
        print("  area = {s.area()}")
    }

    let sq = Square(2.0)
    print(sq.describe())

    // a class with no init at all
    let c = Counter()
    c.bump()
    c.bump()
    print("counter = {c.value()}")

    // identity comparison
    let a = Counter()
    let b = a
    print(a == b, a == c)
}
