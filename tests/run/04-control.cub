string classify(n: int) {
    if n < 0 {
        return "negative"
    } else if n == 0 {
        return "zero"
    } else if n < 10 {
        return "small"
    } else {
        return "large"
    }
}

void main() {
    for n in [-3, 0, 5, 50] {
        print("{n} is {classify(n)}")
    }

    var i = 0
    while i < 5 {
        i += 1
        if i == 2 {
            continue
        }
        if i == 4 {
            break
        }
        print("i = {i}")
    }

    for x in 0..3 {
        for y in 0..3 {
            if x == y {
                continue
            }
            write("{x}{y} ")
        }
    }
    print("")

    for k in 3..=1 {
        print("never runs {k}")
    }
    print("done")
}
