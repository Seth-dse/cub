int fib(n: int) {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

bool is_even(n: int) {
    if n == 0 {
        return true
    }
    return is_odd(n - 1)
}

bool is_odd(n: int) {
    if n == 0 {
        return false
    }
    return is_even(n - 1)
}

void greet(who: string, times: int) {
    for i in 0..times {
        print("hi {who}")
    }
}

[int] doubled(items: [int]) {
    var out: [int] = []
    for n in items {
        push(out, n * 2)
    }
    return out
}

void main() {
    print(fib(20))
    print(is_even(10), is_odd(10))
    greet("cub", 2)
    print(doubled([1, 2, 3]))
}
